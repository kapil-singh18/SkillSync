# Server Environment Configuration
NODE_ENV=production
PORT=5000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillsync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin (used by CORS and Socket.io)
CLIENT_URL=https://skillsync.vercel.app
